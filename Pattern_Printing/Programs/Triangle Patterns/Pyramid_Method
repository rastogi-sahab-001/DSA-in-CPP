#include <iostream>
using namespace std;

int main()
{
    int n;
    cout << "Enter number: ";
    cin >> n;

    int space = n - 1;

    for (int i = 1; i <= n; i++)
    {
        int star = 2 * i - 1;

        for (int k = 1; k <= space; k++)
        {
            cout << "  ";
        }

        for (int j = 1; j <= star; j++)
        {
            cout << "* ";
        }

        space--;
        cout << endl;
    }

    return 0;
}